HOST=localhost
SITE_FULL_URL=http://localhost/
MEDIA_URL=http://localhost/
DEBUG=1
SECRET_KEY=<secret key>

EVENT_DAEMON_POST=ws://wsevent:15101/
REDIS_CACHING_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
BRIDGED_HOST=bridged

# OTS running on the Docker host; use HTTPS for public hosts.
OTS_SYNC_API_URL=http://host.docker.internal:48080
# Must match the dedicated OJ_SYNC_SERVICE_TOKEN on OTS (at least 32 characters).
OTS_SYNC_SERVICE_TOKEN=
OTS_SYNC_TIMEOUT_SECONDS=10
OTS_SYNC_PAGE_SIZE=100
OTS_SYNC_ALLOW_INTERNAL_HTTP=1
OTS_SYNC_AUTO_ENABLED=1
