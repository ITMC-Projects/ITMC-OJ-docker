DEBUG=0
# Generated once by prod-init (64 random bytes encoded as hex).
SECRET_KEY=
# Public DNS name, without scheme or slash. Multiple hosts separated by commas.
HOST=oj.example.com
ALLOWED_HOSTS=oj.example.com
SITE_FULL_URL=https://oj.example.com/
# Root media URL preserves /martor, /pdf, /submission_file links.
MEDIA_URL=https://oj.example.com/
# HTTPS origins, comma separated. Config adapts to Django 3.2 syntax.
CSRF_TRUSTED_ORIGINS=https://oj.example.com
REDIS_CACHING_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
BRIDGED_HOST=bridged
EVENT_DAEMON_POST=ws://wsevent:15101/
# Reachable HTTPS OTS endpoint; certificate must be valid inside the container.
OTS_SYNC_API_URL=https://ots.example.com
# Generated once. Configure the SAME value as OJ_SYNC_SERVICE_TOKEN on OTS.
OTS_SYNC_SERVICE_TOKEN=
OTS_SYNC_TIMEOUT_SECONDS=10
OTS_SYNC_PAGE_SIZE=100
OTS_SYNC_ALLOW_INTERNAL_HTTP=0
OTS_SYNC_AUTO_ENABLED=1

# Deploy OTS credential API before these OJ changes; distinct service secrets.
OTS_PASSWORD_API_URL=https://ots.example.com
OTS_PASSWORD_SERVICE_TOKEN=
OTS_CREDENTIAL_READ_TOKEN=
OTS_CALLBACK_TOKEN=
OTS_PASSWORD_TIMEOUT_SECONDS=5
OTS_PASSWORD_CHANGE_ENABLED=0
